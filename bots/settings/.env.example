# forge-settings – Konfiguration
# Kopieren nach .env und anpassen

# Port des HTTPS-Servers (Standard: 3200)
PORT=3200

# Port des HTTP CA-Download-Servers (Standard: 3201, kein TLS)
PORT_CA=3201

# Port des lokalen forge-premium-Dienstes (Nostr/Message Center), den
# routes/messages.js anspricht (Standard: 3110, siehe core/premium/server.js)
PREMIUM_PORT=3110

# Zeitzone
FORGE_TZ=Europe/Berlin
