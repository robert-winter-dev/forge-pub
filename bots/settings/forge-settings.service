[Unit]
Description=FORGE Settings – Interner HTTPS Admin-Server
After=network.target forge-nexus.service forge-premium.service
Wants=forge-nexus.service forge-premium.service

[Service]
Type=simple
User=forge
WorkingDirectory=/opt/forge/app/bots/settings
Environment=FORGE_ENV_DIR=/opt/forge/local/env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Stop/Restart beendet nur server.js, nicht dessen losgelöste Finanzaktionen
# (Einzahlung, Entnahme, Burn) — die laufen zu Ende, siehe lib/finance-jobs.js, CORE#000993.
KillMode=process

# Weiche Speicherbremse (Reclaim/Throttling, kein Kill) – kein MemoryMax, siehe CORE#000463.
MemoryHigh=384M

Environment=NODE_ENV=production
EnvironmentFile=-/opt/forge/local/env/settings.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-settings

[Install]
WantedBy=multi-user.target
