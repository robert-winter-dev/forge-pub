# ─── Solana & Wallet ──────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_KEYPAIR_PATH=/path/to/your/wallet-keypair.json
# SOL-Reserve die NICHT angefasst wird (für Fees)
SOL_RESERVE=0.05

# ─── Bot Identifikation ────────────────────────────────────────────────────────
BOT_ID=lendinbot-1
BOT_DISPLAY_NAME=FORGE Lending Bot

# ─── Telegram Notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Aktive Protokolle (comma-separated) ──────────────────────────────────────
# Optionen: kamino, kamino-figure, kamino-onre, kamino-huma, jupiter, loopscale-genesis, loopscale-onre
LENDING_PROTOCOLS=kamino,jupiter

# Zusätzliche Protokolle NUR zur APY-Beobachtung (Settings-UI, Auto-Deploy
# "Bester Pool"/"Bestimmter Pool"-Auswahl) – werden nicht automatisch bespielt,
# solange sie nicht auch in LENDING_PROTOCOLS stehen oder manuell aktiviert
# werden. Ohne diese Zeile bleiben alle hier gelisteten Pools ohne APY-Daten.
MONITOR_PROTOCOLS=kamino-figure,kamino-onre,kamino-huma,loopscale-genesis,loopscale-onre

# ─── Kamino Finance ───────────────────────────────────────────────────────────
# Main Market (unveränderlich – nur ändern wenn Kamino neuen Market deployed)
KAMINO_MARKET=7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF
# USDC Reserve in diesem Market
KAMINO_USDC_RESERVE=D6q6wuQSrifJKZYpR1M8R4YawnLDtDsMmWM1NbBmgJ59

# ─── APY-Monitoring ───────────────────────────────────────────────────────────
# Alert wenn APY eines aktiven Protokolls unter diesen Wert fällt (in %)
APY_THRESHOLD_PERCENT=5
# Wie oft APYs aktualisiert werden (in ms, Standard: 1 Stunde)
APY_UPDATE_INTERVAL_MS=3600000

# ─── Rebalancing (Phase 2) ────────────────────────────────────────────────────
AUTO_REBALANCE_ENABLED=false
REBALANCE_THRESHOLD_PERCENT=2

# ─── Compounding (Phase 2) ────────────────────────────────────────────────────
AUTO_COMPOUNDING_ENABLED=false


# ─── Zeitzone ─────────────────────────────────────────────────────────────────
# IANA-Zeitzone für alle Tagesgrenzen (heute/gestern/Woche/Monat).
# Standard: Europe/Berlin. Weitere Werte: Europe/London, America/New_York, UTC …
FORGE_TZ=Europe/Berlin

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
