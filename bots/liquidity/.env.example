# ─── Wallet & RPC ─────────────────────────────────────────────────────────────
KEYPAIR_PATH=/path/to/your/wallet-keypair.json
RPC_URL=http://localhost:3100/rpc
# WebSocket-Endpunkt für TX-Bestätigung (sendAndConfirmTransaction). Nexus proxied nur
# HTTP-JSON-RPC (siehe core/nexus/server.js) — WS geht direkt zu Helius, zählt nicht gegen
# das HTTP-Limit. OHNE diesen Wert leitet @solana/web3.js den WS-Endpoint automatisch vom
# RPC_URL-Port ab (hier: ws://localhost:3101/rpc) — dort läuft aber nichts, jede TX-
# Bestätigung braucht dann den langsameren Polling-Fallback und kann bei Netzwerk-Last vor
# der eigentlichen On-Chain-Landung in "block height exceeded" laufen (2026-07-27 auf
# forge-pub1 beobachtet, siehe doc/CHANGELOG/2026-07-27.md).
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=dein-helius-key

# ─── SOL-Reserve (wird niemals angetastet, nur für TX-Fees) ───────────────────
SOL_RESERVE=0.10

# ─── USDC-Reserve für FORGE.pub-Premium (wird niemals investiert) ────────────
# Nur relevant, wenn die optionale Premium-Datenzahlung aktiviert ist (0,10 USDC/h).
# 0 = kein Effekt, Cleanup investiert wie bisher jedes freie USDC.
PREMIUM_RESERVE_USDC=0

# ─── Range-Überwachung ────────────────────────────────────────────────────────
# Wie oft der Bot prüft ob die Position in Range liegt (Millisekunden)
CHECK_INTERVAL_MS=300000

# ─── Rebalancing ──────────────────────────────────────────────────────────────
REBALANCE_ENABLED=true
# Buffer: Position gilt erst als out-of-range wenn Preis X% über/unter Range-Grenze
REBALANCE_THRESHOLD_PCT=2
# Cooldown zwischen automatischen Rebalancings (Minuten). Manuelle Trigger ignorieren den Cooldown.
REBALANCE_COOLDOWN_MINUTES=120

# ─── Risikomanagement (SL / TP / Trailing Stop) ───────────────────────────────
# Slippage-Toleranz für Swaps nach SL/TP/TS-Exit (Basispunkte, 100 = 1 %).
# Höher als Cleanup-Swaps (150 bps): Ausführung hat Vorrang vor Preis-Optimierung.
RM_SWAP_SLIPPAGE_BPS=300

# ─── Range-Modus ──────────────────────────────────────────────────────────────
# 'fixed': Range = aktueller Preis ± RANGE_FIXED_PCT%
# 'atr':   Range = aktueller Preis ± (ATR(RANGE_ATR_PERIOD) × RANGE_ATR_MULTIPLIER)
RANGE_MODE=fixed

# fixed-Modus: halbe Range-Breite in % (z.B. 20 = Range ±20% vom aktuellen Preis)
RANGE_FIXED_PCT=20

# atr-Modus: Periode und Multiplikator (wöchentlich manuell anpassen)
RANGE_ATR_PERIOD=14
RANGE_ATR_MULTIPLIER=2.0

# ─── Fee-Harvesting ───────────────────────────────────────────────────────────
# Wie oft Fees automatisch geclaimed werden (Millisekunden), Default 1h
FEE_CLAIM_INTERVAL_MS=3600000
# Mindest-Pending-Fees in USDC bevor geclaimed wird (verhindert unrentable Micro-Claims)
FEE_CLAIM_MIN_USDC=0.10
# 'reinvest': Fees werden per increase_liquidity in bestehende Position reinvestiert
# 'transfer': Fees werden an REWARD_TARGET übertragen
REWARD_ACTION=reinvest
# Nur relevant wenn REWARD_ACTION=transfer
# REWARD_TARGET=<Solana-Adresse>

# ─── Portfolio-Tracking ───────────────────────────────────────────────────────
# Wie oft Portfolio-Snapshots geschrieben werden (Millisekunden), Default 5min
PORTFOLIO_SNAPSHOT_INTERVAL_MS=300000

# ─── Dashboard-Export ─────────────────────────────────────────────────────────
# Wie oft data.json aktualisiert wird (Millisekunden)
EXPORT_INTERVAL_MS=60000

# ─── Alerts ───────────────────────────────────────────────────────────────────
# Alert wenn Pool-APR unter diesen Wert fällt (%)
APR_ALERT_THRESHOLD=10
# Alert wenn Pool-TVL um mehr als X% in 24h einbricht
TVL_DROP_ALERT_PCT=20
# Alert wenn Position seit mehr als X Minuten out-of-range ist
OUT_OF_RANGE_ALERT_MINUTES=30

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Agora (Ticket-Dienst) ────────────────────────────────────────────────────
# Token für den Akteur 'forge:master' (nur Befund-Tickets, keine Aufträge).
# Anlegen: ssh talos sudo -u agora env HOME=/opt/agora node /opt/agora/bin/token.js neu forge:master
AGORA_URL=http://203.0.113.50:7331
AGORA_TOKEN=

# ─── Zeitzone ─────────────────────────────────────────────────────────────────
# IANA-Zeitzone für alle Tagesgrenzen (heute/gestern/Woche/Monat).
# Standard: Europe/Berlin. Weitere Werte: Europe/London, America/New_York, UTC …
FORGE_TZ=Europe/Berlin

