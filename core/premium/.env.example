# forge-premium – Konfiguration
# Kopieren nach .env und anpassen (auf dem Master reichen die Defaults)

# Port des lokalen HTTP-Servers (nur 127.0.0.1, kein LAN-Zugriff)
PORT=3110

# Verzeichnis für den privaten Nostr-Schlüssel.
# Master (leer lassen): data/secrets/nostr/
# FORGE.pub: wird vom Installer auf /opt/forge/secrets gesetzt — dasselbe geschützte
# Verzeichnis (0700), in dem auch die Wallet-Keys liegen.
NOSTR_SECRETS_DIR=

# Name der eigenen Identität (= Dateiname ohne .json im Verzeichnis oben).
# Master: FORGE.Master (Default) · FORGE.pub: forge-pub-nostr
NOSTR_IDENTITY=

# Keypair-Datei des Premium-Wallets (bezahlt den FORGE.pub-Datendienst).
# Nur auf einem FORGE.pub-Fork gesetzt (vom Installer) — auf dem Master leer
# lassen. Gelesen von lib/premium-wallet.js und lib/premium-identity-context.js
# (letzteres nutzt NOSTR_IDENTITY oben, nicht diesen Wert, zur Master/Fork-
# Erkennung in geteiltem Code wie bots/settings/**).
PREMIUM_WALLET_PATH=

# Filebase (S3-kompatibel) – primärer Blob-Ablage-Host, MASTER-ONLY. Gelesen von
# lib/blob-storage.js (dependency-freier Parser, siehe dort). Der bisherige Backup-Host
# (PREMIUM_BLOB_BASE_URL) bleibt weiterhin als automatisches Backup aktiv (kein Umschalten
# nötig). Leer lassen = kein Filebase-Upload, reiner Backup-Host-Betrieb wie bisher.
PREMIUM_BLOB_FILEBASE_ACCESS_KEY=
PREMIUM_BLOB_FILEBASE_SECRET_KEY=
PREMIUM_BLOB_FILEBASE_BUCKET=forge-dl
PREMIUM_BLOB_FILEBASE_ENDPOINT=https://s3.filebase.io
