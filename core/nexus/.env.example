# FORGE Nexus – Zentrale Konfiguration
# Kopiere diese Datei nach .env und trage die echten Werte ein.
# Diese Datei (.env.example) wird committed; .env NIEMALS.

# Jupiter API Key (https://portal.jup.ag)
# Gilt für: SpotGridBot (Swap, Trigger, Quote) + LendingBot (Earn)
JUPITER_API_KEY=dein-key-hier

# Helius RPC API Key (https://helius.dev)
HELIUS_API_KEY=dein-key-hier

# Telegram – für Lifecycle- und Critical-Notifications
# Gleiche Zugangsdaten wie in den Bot .env-Dateien
# Nur level=error wird zu Telegram gesendet; info/warn nur in nexus.db
TELEGRAM_BOT_TOKEN=dein-token-hier
TELEGRAM_CHAT_ID=deine-chat-id-hier

# ─── Zeitzone ─────────────────────────────────────────────────────────────────
# IANA-Zeitzone – für Logs und Tages-Reports.
FORGE_TZ=Europe/Berlin

# Spam-Prevention – Deduplication-Fenster
# Gleiche botId + category innerhalb des Fensters werden unterdrückt.
# Nach Ablauf: Summary-Meldung wenn mind. 1 Duplikat unterdrückt wurde.
DEDUP_WINDOW_ERROR_MS=120000    # 2 Minuten (default)
DEDUP_WINDOW_WARN_MS=300000     # 5 Minuten (default)

# Spam-Prevention – Rate-Limit pro Bot (info/warn)
# error hat kein Rate-Limit (Dedup gilt trotzdem)
RATE_LIMIT_INFO_PER_HOUR=10     # max. 10 info-Notifications pro Stunde pro Bot
RATE_LIMIT_WARN_PER_HOUR=5      # max. 5 warn-Notifications pro Stunde pro Bot
